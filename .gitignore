# ============================================================
# BWStory React Native - .gitignore
# ============================================================

# ----------------------------
# Node / NPM
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# React Native / Metro
# ----------------------------
.metro-health-check*
*.jsbundle

# ----------------------------
# Android
# ----------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Android Studio
.idea/
*.iml

# Signing / Keystore files
*.keystore
*.jks

# Generated Android packages
*.apk
*.aab

# ----------------------------
# iOS
# ----------------------------
ios/Pods/
ios/build/
DerivedData/
*.xcworkspace
*.xcuserstate
xcuserdata/

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.local
.env.development
.env.production
.env.*.local

# ----------------------------
# VS Code
# ----------------------------
.vscode/

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# Logs
# ----------------------------
*.log
logs/

# ----------------------------
# Temporary files
# ----------------------------
*.tmp
*.temp
*.swp
*.swo
*~

# ----------------------------
# Test / Coverage
# ----------------------------
coverage/

# ----------------------------
# Gradle
# ----------------------------
.gradle/
build/

# ----------------------------
# Misc
# ----------------------------
.cache/
.eslintcache